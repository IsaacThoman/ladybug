# docker compose settings. Copy to .env to override the defaults.

# Shared by Typesense and the server. Change it for anything non-local.
TYPESENSE_API_KEY=ladybug-dev-key
# How long the placeholder analysis takes for an unknown URL.
ANALYSIS_DELAY_MS=30000

SERVER_PORT=3001
# Interface the server is published on. Nothing is authenticated yet, so this
# is localhost-only by default; use 0.0.0.0 to expose it.
SERVER_BIND=127.0.0.1
TYPESENSE_PORT=8108
