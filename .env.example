# docker compose settings. Copy to .env for local use; in Coolify, set these as
# environment variables instead (only the first two are required).

# Required. Local values only: use strong, URL-safe secrets anywhere else.
POSTGRES_PASSWORD=ladybug
TYPESENSE_API_KEY=ladybug-dev-key

# Postgres. Unset = the stack's own TimescaleDB container. To use Tiger Cloud
# instead, paste the service URL from the Tiger console (it ends in
# ?sslmode=require). The local postgres service still starts, but sits idle.
DATABASE_URL=
DATABASE_SSL=false

# Password for the admin sign-in page (/admin), where new accounts are approved.
# Set it before exposing the site.
ADMIN_PASSWORD=
# Optional comma-separated keys that may start scans without an account (scripts).
API_KEYS=

# Model endpoint for the scan agent: any OpenAI-compatible Chat Completions API.
# LLM_MODEL is the default; admins can pick another of the endpoint's models
# in the admin UI (Settings). Leave LLM_API_KEY empty for signal-only reports.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional threat-intel lookups.
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# Concurrent scans; each sandbox takes up to 2 CPUs and 3 GB.
WORKER_CONCURRENCY=2
# Where sandboxes run: docker (this host) or k8s (a remote cluster). For k8s,
# infra/k8s/bootstrap.sh --sandbox-only writes these values; see infra/README.md.
SANDBOX_PROVIDER=docker
SANDBOX_IMAGE=ladybug-sandbox:latest
SANDBOX_KUBECONFIG_B64=
SANDBOX_IMAGE_PULL_SECRET=
SANDBOX_ENV_CONFIGMAP=
# scan, or placeholder for URL heuristics without sandboxes.
ANALYZER=scan

# Community reports on Solana (docs/solana.md). Leave these empty and reports
# stay in Postgres. SOLANA_AUTHORITY_KEY is the server's keypair (a JSON byte
# array as solana-keygen writes it, or base58): it pays every fee, so keep it
# funded. SOLANA_REPORTER_SECRET is a random string per-account reporter keys
# are derived from; changing it gives every account a second vote.
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet
SOLANA_PROGRAM_ID=
SOLANA_AUTHORITY_KEY=
SOLANA_REPORTER_SECRET=

# Local host ports (compose.local.yaml).
WEB_PORT=8080
SERVER_PORT=3001
TYPESENSE_PORT=8108
POSTGRES_PORT=5432
VALKEY_PORT=6379

# Outbound FaceTime: server-only provider credentials and fixed destination.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
EMERGENCY_NUMBER=
# Pets call as their signed-in account; turn calls on per account in the admin UI.

# Shared-line texts use CHERT_API_KEY, CHERT_PROJECT_ID and CHERT_LINE_ID above.
# Register the emergency phone with the join code in app.trychert.com → Messages.
# No messaging tenant or webhook secret is required.
