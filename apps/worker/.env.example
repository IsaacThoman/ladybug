DATABASE_URL=postgres://ladybug:ladybug@localhost:5432/ladybug
REDIS_URL=redis://localhost:6379
# local (default, .artifacts/ at the repo root) or s3
ARTIFACT_STORE=local

# Any OpenAI-compatible Chat Completions endpoint. Needs tool calling;
# vision is used for screenshots unless LLM_VISION=false.
# LLM_MODEL is the default; admins can pick another of the endpoint's models
# in the admin UI (Settings). Leave LLM_API_KEY unset for signal-only reports.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_VISION=true

# docker (default) or k8s
SANDBOX_PROVIDER=docker
SANDBOX_IMAGE=ladybug-sandbox:dev

# Optional threat-intel keys.
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
