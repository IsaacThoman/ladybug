**/node_modules
**/dist
**/dist-electron
**/release
**/.env
**/.env.local
**/*.log
.git
.DS_Store
.artifacts
.playwright-cli

# Infra secrets and state never belong in an image.
**/secrets.env
**/.generated
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/*.tfvars

# No image needs these apps' sources; `npm ci` only needs their package.json
# to see the whole workspace.
apps/desktop/*
!apps/desktop/package.json
apps/extension/*
!apps/extension/package.json
