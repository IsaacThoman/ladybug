# Copy to secrets.env (gitignored). kubectl env files use literal values: no quotes,
# export, or shell interpolation. Empty reputation/AI keys enable signal-only mode.
# Key for the OpenAI-compatible endpoint. Set LLM_BASE_URL and LLM_MODEL in the
# environment when running bootstrap.sh; they go in the ConfigMap.
LLM_API_KEY=
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
# Comma-separated API keys; set a strong value before exposing the API.
API_KEYS=

# Also in ladybug-secrets, supplied automatically by Terraform (do not uncomment):
# DATABASE_URL=
# REDIS_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# TYPESENSE_API_KEY= (generated once, then kept)
