{
  "name": "ladybug",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,worker,web,desktop -c blue,yellow,green,magenta \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:server": "npm run dev -w @ladybug/server",
    "dev:desktop": "npm run dev -w @ladybug/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "dev:worker": "npm run dev -w @ladybug/worker",
    "dev:web": "npm run dev -w @ladybug/web",
    "dev:sandbox": "npm run dev -w @ladybug/sandbox",
    "test": "npm run test --workspaces --if-present",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
