PORT=3001
# Typesense stores known URLs and the activity log. `npm run typesense` starts one.
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=ladybug-dev-key

# Sandbox scans: Postgres for scans, Valkey for the queue and live events.
# `npm run services:up` starts both.
DATABASE_URL=postgres://ladybug:ladybug@localhost:5432/ladybug
REDIS_URL=redis://localhost:6379
# local (default, .artifacts/ at the repo root) or s3
ARTIFACT_STORE=local

# How unknown URLs from the extension are analysed: scan (a sandbox scan via
# the worker) or placeholder (naive URL heuristics after ANALYSIS_DELAY_MS).
ANALYZER=scan
ANALYSIS_DELAY_MS=30000

# Password for the admin sign-in page, where new accounts are approved;
# /api/admin then needs its session cookie (or HTTP Basic, any username). Unset = open.
ADMIN_PASSWORD=
# Optional comma-separated keys that may start scans without an account (scripts).
API_KEYS=
RATE_LIMIT_PER_MINUTE=10
# Reverse proxies in front of the server, and an optional trusted client-IP
# header (e.g. cf-connecting-ip behind a Cloudflare Tunnel), for rate limits.
TRUST_PROXY_HOPS=1
CLIENT_IP_HEADER=

# Built admin UI to serve at /admin (defaults to apps/admin/dist).
# ADMIN_DIST=

# Outbound FaceTime: server-only provider credentials and fixed destination.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
EMERGENCY_NUMBER=
# Pets call as their signed-in account; turn calls on per account in the admin UI.

# Shared-line texts use CHERT_API_KEY, CHERT_PROJECT_ID and CHERT_LINE_ID above.
# Register the emergency phone with the join code in app.trychert.com → Messages.
# No messaging tenant or webhook secret is required.
