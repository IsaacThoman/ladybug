# docker compose settings. Copy to .env for local use; in Coolify, set these as
# environment variables instead (only the first two are required).

# Required. Local values only: use strong, URL-safe secrets anywhere else.
POSTGRES_PASSWORD=ladybug
TYPESENSE_API_KEY=ladybug-dev-key

# Postgres. Unset = the stack's own TimescaleDB container. To use Tiger Cloud
# instead, paste the service URL from the Tiger console (it ends in
# ?sslmode=require). The local postgres service still starts, but sits idle.
DATABASE_URL=
DATABASE_SSL=false

# Password for the admin sign-in page (/admin). Set it before exposing the site.
ADMIN_PASSWORD=
# Comma-separated keys allowed to start scans. Empty = anyone can.
API_KEYS=

# Model endpoint for the scan agent: any OpenAI-compatible Chat Completions API.
# Leave LLM_API_KEY or LLM_MODEL empty for signal-only reports.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional threat-intel lookups.
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# Concurrent scans; each sandbox takes up to 2 CPUs and 3 GB.
WORKER_CONCURRENCY=2
# scan, or placeholder for URL heuristics without sandboxes.
ANALYZER=scan

# Local host ports (compose.local.yaml).
WEB_PORT=8080
SERVER_PORT=3001
TYPESENSE_PORT=8108
POSTGRES_PORT=5432
VALKEY_PORT=6379

# Outbound FaceTime: server-only provider credentials and fixed destination.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
EMERGENCY_NUMBER=
# Comma-separated per-installation desktop tokens. Required; empty disables calls.
CALL_CLIENT_KEYS=
