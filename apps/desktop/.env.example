# Where the desktop app reaches the backend. Defaults: http://localhost:3001 in
# `npm run dev`, https://ladybugg.garden in packaged builds. A value set here
# applies to both, so leave these commented unless you mean to override.
# VITE_SERVER_URL=http://localhost:3001
# Where "open the report" points (apps/web). Defaults: http://localhost:5175 in
# dev, https://ladybugg.garden in packaged builds.
# VITE_WEB_URL=http://localhost:5175
# Sent as x-api-key when creating scans. Leave unset if the server has no API_KEYS.
# VITE_API_KEY=
