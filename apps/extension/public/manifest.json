{
  "manifest_version": 3,
  "name": "Computerbug",
  "version": "0.1.0",
  "description": "Reports the pages you visit to your Computerbug server, so your ladybug can warn you about unsafe sites, right over the page.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Computerbug",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ladybug-16.png",
      "32": "icons/ladybug-32.png",
      "48": "icons/ladybug-48.png"
    }
  },
  "icons": {
    "16": "icons/ladybug-16.png",
    "32": "icons/ladybug-32.png",
    "48": "icons/ladybug-48.png",
    "128": "icons/ladybug-128.png"
  },
  "permissions": ["webNavigation", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["warning.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
