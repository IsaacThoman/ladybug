# cp terraform.tfvars.example terraform.tfvars
region            = "sjc"
sandbox_min_nodes = 2
sandbox_max_nodes = 6
# Must be globally unique.
registry_name    = "ladybugdemo"
artifacts_bucket = "ladybug-artifacts-demo"

# Sandboxes only: the server and worker stay elsewhere (e.g. Coolify), and this
# cluster runs just the sandbox pods and the egress gateway. No managed
# databases or Object Storage are created. See infra/README.md.
# sandbox_only      = true
# system_nodes      = 1
# sandbox_min_nodes = 2
# One sandbox per node instead of three (smaller, cheaper nodes):
# sandbox_plan      = "vc2-2c-4gb"

# The Container Registry isn't offered everywhere (e.g. not in atl).
# registry_region = "ewr"
